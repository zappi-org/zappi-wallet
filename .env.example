VITE_ZAPPI_SUPPORT_AGENT_NPUB=npub15dyu2nnzckggfe6ccz465cx0cnsf6g3mmpr5h8nau3jt49w0ydkslj83ty
VITE_ZAPPI_SUPPORT_BOOTSTRAP_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://nostr.vulpem.com
VITE_ZAPPI_SUPPORT_BLOSSOM_SERVERS=https://blossom.primal.net

# Release channel (main | staging | nightly). Defaults to main.
# main = open beta (no invite code required)
# staging/nightly = invite code required
VITE_ZAPPI_CHANNEL=main

# Comma-separated invite codes. Leave empty to disable the gate.
VITE_ZAPPI_INVITE_CODES=

# Kkachi push server (blind Web Push wake hints). Empty = feature disabled.
# HTTPS dev: the page is served over HTTPS, so the push server must be HTTPS too
# (mixed content is blocked). Run kkachi with TLS_CERT/TLS_KEY pointing at certs/dev.pem.
# VITE_KKACHI_SERVER_URL=https://localhost:8787
# VITE_KKACHI_VAPID_PUBLIC_KEY=
# Show the push diagnostics section in Settings (relay/register/self-1059).
# Works in preview builds too (unlike import.meta.env.DEV). Keep out of production.
# VITE_KKACHI_DEV_TOOLS=1
